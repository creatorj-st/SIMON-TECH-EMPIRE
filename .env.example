# Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Server Configuration
PORT=3000
NODE_ENV=production

# Owner Configuration
OWNER_NUMBER=YOUR_WHATSAPP_NUMBER
